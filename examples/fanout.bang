// 병렬 API 팬아웃 — spawn의 킬러 데모
//
// 여러 URL을 "동시에" 가져와 결과를 모은다. async/await도, 이벤트 루프도,
// 콜백도 없다 — parallel_map 안에서 http_get을 부르면 각 요청이 별도 작업으로
// 진짜 병렬 실행되고, 결과 리스트로 자동 조인된다.
//
// 같은 일을 Python으로 하려면 aiohttp + async def + async with + gather +
// asyncio.run (약 25줄, 함수 전체가 async로 색칠됨). 여기서는 4줄이다.
//
// 실행: 먼저 로컬 테스트 서버가 필요하면 examples/http_server.bang 참고.
//       공개 http 엔드포인트로 바꿔도 된다(https는 1차 미지원).
//
// 기대 출력(로컬 서버 3개 라우트 기준):
//   가져온 페이지: 3
//   상태 코드: [200, 200, 200]

let urls = [
    "http://127.0.0.1:8080/a",
    "http://127.0.0.1:8080/b",
    "http://127.0.0.1:8080/c"
]

// 이 한 줄이 전부다 — 3개 요청이 동시에 나가고, 응답이 순서대로 모인다.
let pages = parallel_map(urls, fn(url) { return http_get(url) })

print("가져온 페이지: " + str(len(pages)))

let codes = []
for page in pages {
    codes = push(codes, page.status)
}
print("상태 코드: " + str(codes))
