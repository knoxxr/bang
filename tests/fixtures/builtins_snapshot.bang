// 빌트인 동작 스냅샷 (Phase 44 리팩터링 전 기록). 정답: builtins_snapshot.expected
// 번호↔구현 연결이 바뀌면(예: 50번 이름에 다른 구현) 출력이 달라져 잡힌다.
// 비결정적(now_ms/random)·외부 의존(tcp/http/proc/input/exit/serve_event/import)은 타입·범위만 본다.

// 기본/변환
print("a", 1, 2.5, true, nil, [1, "x"], {"k": 1})
print(str(12), int("42"), int(3.9), float("1.5"), float(2), bool(0), bool(nil), bool(""))
print(len([1, 2]), len("héllo"), len({"a": 1}), type(1), type("s"), type([]), type({}), type(nil))
print(push([1], 2), pop([1, 2]), keys({"b": 1, "a": 2}), values({"x": 9}))
print(range(3), range(1, 4), range(0, 10, 3))
assert(true)
// 문자열
print(split("a,b,c", ","), join(["a", "b"], "-"), trim("  x "), trim_start("  x "), trim_end("  x "))
print(replace("aaa", "a", "b"), contains("abc", "b"), starts_with("abc", "ab"), ends_with("abc", "bc"))
print(upper("aB"), lower("aB"), find("abc", "c"), find("abc", "z"), chars("ab"))
// 리스트
print(sort([3, 1, 2]), reverse([1, 2, 3]), map([1, 2], fn(x) { return x * 10 }), filter([1, 2, 3], fn(x) { return x > 1 }))
print(reduce([1, 2, 3], fn(a, b) { return a + b }, 0), any([1, 2], fn(x) { return x > 1 }), all([1, 2], fn(x) { return x > 1 }))
print(flat([[1], [2, 3]]), enumerate(["a", "b"]), zip([1, 2], ["a", "b"]), sum([1, 2, 3]))
print(slice([1, 2, 3, 4], 1, 3), slice("hello", 1, 3), index_of([5, 6], 6), unique([1, 1, 2]))
print(sort_by(["bb", "a", "ccc"], fn(s) { return len(s) }))
// 맵
print(has({"a": 1}, "a"), get({"a": 1}, "b", 0), merge({"a": 1}, {"b": 2}), repeat("ab", 3))
// 수학
print(abs(-3), abs(-2.5), sqrt(16), floor(2.7), ceil(2.1), round(2.5), pow(2, 10), min(3, 1), max([4, 9, 2]))
print(gcd(12, 18), clamp(15, 0, 10), sign(-4), round(sin(0)), round(cos(0)), round(tan(0)))
print(round(log(e())), log10(1000), round(exp(0)), floor(pi() * 100))
print(union([1, 2], [2, 3]), intersect([1, 2], [2, 3]), difference([1, 2], [2, 3]))
// JSON/시간/난수/문자
print(json_parse("{\"a\": [1, 2.5, null, true]}"), json_stringify({"b": [1, "x"], "a": nil}))
print(type(now_ms()), now_ms() > 0, type(random()), random() < 1)
let ri = random_int(1, 3)
print(ri >= 1 and ri <= 3, format_time(0), ord("A"), chr(66))
// 정규식
print(regex_match("2023-01-02", "^\\d{4}-\\d{2}-\\d{2}$"), regex_find("a12b", "\\d+"), regex_find_all("a1b22", "\\d+"))
print(regex_replace("a1b2", "\\d", "#"), regex_groups("k=v", "(\\w)=(\\w)"))
// 동시성
let ch = channel(2)
send(ch, 1)
send(ch, [2])
print(recv(ch), recv(ch))
close(ch)
print(select([ch]))
fn dbl(x) { return x * 2 }
print(parallel_map([1, 2, 3], dbl), wait(spawn dbl(21)))
// 파일시스템/시스템 (테스트가 빈 임시 디렉터리를 cwd로 둔다)
dir_create("d/e")
write_file("d/e/f.txt", "hi")
file_append("d/e/f.txt", "!")
print(read_file("d/e/f.txt"), file_size("d/e/f.txt"), file_exists("d/e/f.txt"), is_dir("d/e"), list_dir("d"))
file_move("d/e/f.txt", "d/g.txt")
print(sort(list_dir("d")))
file_remove("d/g.txt")
print(file_exists("d/g.txt"), env_get("BANG_SNAPSHOT_NO_SUCH_VAR"), type(env_cwd()), sleep(0), type(args()))
// 바이트
let b = bytes_from_str("hé")
print(b, bytes_to_str(b), bytes_to_hex(b), bytes_from_hex("00ff"))
write_file("b.bin", bytes_from_hex("0001ff"))
print(file_read_bytes("b.bin"))
