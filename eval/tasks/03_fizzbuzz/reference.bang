fn fizzbuzz(n) {
    let out = []
    for i in range(1, n + 1) {
        if i % 15 == 0 {
            out += ["FizzBuzz"]
        } else if i % 3 == 0 {
            out += ["Fizz"]
        } else if i % 5 == 0 {
            out += ["Buzz"]
        } else {
            out += [str(i)]
        }
    }
    return out
}
